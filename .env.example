# Provider used by the extractor: "openrouter" (default, required for the deployed app)
# or "openai" (optional, for local development with your own key).
LLM_PROVIDER=openrouter

# OpenRouter key issued for this challenge. Used by the eval baseline and the deployment.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Optional: your own OpenAI key for development runs (not used by the deployment).
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: model used by judge.py to score the bonus summary (default: gpt-4.1 on the active provider).
JUDGE_MODEL=

# Reference date for expiration_status (YYYY-MM-DD). Defaults to today when empty.
# The eval uses the date in expected/_reference.json.
REFERENCE_DATE=
EXPIRING_WINDOW_DAYS=60
